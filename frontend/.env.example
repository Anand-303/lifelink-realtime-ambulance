# Dev server (omit or use 3000; set 3001 if "Something is already running on port 3000")
# PORT=3001

# Backend API
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_SOCKET_URL=http://localhost:5000

# Google Maps (required for map and nearby hospitals)
# Enable Maps JavaScript API and Places API in Google Cloud Console
REACT_APP_GOOGLE_MAPS_API_KEY=PASTE_YOUR_API_KEY_HERE
